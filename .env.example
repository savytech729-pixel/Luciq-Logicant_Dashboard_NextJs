DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/ai-talent-platform?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY="replace-with-google-gemini-api-key"
# Optional — defaults shown (use AI Studio model ids: https://ai.google.dev/gemini-api/docs/models )
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MODEL_FALLBACK="gemini-2.5-pro"
AI_BUDGET_MODE="low"
AI_DAILY_CALL_LIMIT="120"
AI_CACHE_TTL_MS="86400000"
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
# Must match the processor region in Google Cloud Console (e.g. asia-south1)
GOOGLE_CLOUD_LOCATION="asia-south1"
GOOGLE_DOCUMENT_AI_PROCESSOR_ID="your-docai-processor-id"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN="replace-with-brevo-smtp-login"
BREVO_SMTP_KEY="replace-with-brevo-smtp-key"
BREVO_FROM_EMAIL="no-reply@yourdomain.com"
BREVO_API_KEY="replace-with-brevo-transactional-api-key"
APP_URL="https://your-domain.com"
ALERT_SLACK_WEBHOOK_URL=""
ALERT_EMAIL_TO=""
